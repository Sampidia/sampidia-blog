    "NEXT_PUBLIC_GA_MEASUREMENT_ID": "G-TJD1FB06JT",
    "NEXT_PUBLIC_ADSENSE_CLIENT_ID": "ca-pub-1169009766287256",
    "NEXT_PUBLIC_ADSENSE_SLOT_HOMEPAGE_TOP": "7652411262",
    "NEXT_PUBLIC_ADSENSE_SLOT_HOMEPAGE_BOTTOM": "6642581928",
    "NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE_TOP": "7652411262",
    "NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE_BOTTOM": "7813183049",
    "NEXT_PUBLIC_ADSENSE_SLOT_POST_SIDEBAR": "5187019703",
    "NEXT_PUBLIC_CUSDIS_APP_ID": "c3da25cf-9ca7-4de0-8e6d-74d1a0be5fe5"
  }
}